<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for Disbursement Cycle -->
    <record id="view_g2p_disbursement_cycle_form" model="ir.ui.view">
        <field name="name">g2p.disbursement.cycle.form</field>
        <field name="model">g2p.disbursement.cycle</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_refresh_data" type="object" string="Refresh Data" class="btn-secondary" icon="fa-refresh" invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="is_readonly" invisible="1"/>
                            <field name="has_wip_list" invisible="1"/>
                            <field name="program_id" readonly="1"/>
                            <field name="cycle_mnemonic" readonly="is_readonly"/>
                            <field name="target_registry" invisible="1"/>
                        </group>
                        <group string="Summary">
                            <field name="list_count" string="Total Lists" readonly="1"/>
                            <field name="approved_count" string="Approved" readonly="1"/>
                            <field name="pending_count" string="Pending" readonly="1"/>
                            <field name="wip_stage_name" string="WIP Stage" readonly="1" invisible="not wip_stage_name"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Priority Rules -->
                        <page string="Disbursement Rules" invisible="id == False">
                            <field name="priority_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_target_registry': target_registry}"/>
                        </page>
                        <!-- Disbursement List -->
                        <page string="Disbursement List" invisible="id == False">
                            <field name="beneficiary_list_ids" nolabel="1">
                                <tree default_order="creation_date desc" delete="false" limit="10">
                                    <control>
                                        <create string="Create New Disbursement List" invisible="parent.has_wip_list"/>
                                    </control>
                                    <field name="mnemonic" string="Mnemonic"/>
                                    <field name="eligibility_process_status" string="Priority Process Status" widget="badge"/>
                                    <field name="entitlement_process_status" string="Entitlement Status" widget="badge"/>
                                    <field name="workflow_approval_status" string="Approval Status" widget="badge"/>
                                    <field name="current_stage_name" string="Current Stage"/>
                                    <field name="creation_date" string="Created On" readonly="1"/>
                                    <field name="processed_date" string="Processed On" readonly="1"/>
                                    <button name="action_approve_stage" type="object" string="Approve" class="btn-success"
                                        invisible="workflow_approval_status != 'PENDING'"
                                        groups="g2p_pbms.group_disbursement_approver"/>
                                    <button name="action_reject_stage" type="object" string="Reject" class="btn-danger"
                                        invisible="workflow_approval_status != 'PENDING'"
                                        groups="g2p_pbms.group_disbursement_approver"/>
                                    <button name="action_open_summary_wizard" type="object" string="View List" class="oe_link"
                                        invisible="entitlement_process_status != 'complete'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Disbursement Cycle -->
    <record id="action_disbursement_cycle" model="ir.actions.act_window">
        <field name="name">Disbursement Cycle</field>
        <field name="res_model">g2p.disbursement.cycle</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
    </record>

    <!-- Tree view for Disbursement Cycle -->
    <record id="view_g2p_disbursement_cycle_tree" model="ir.ui.view">
        <field name="name">g2p.disbursement.cycle.tree</field>
        <field name="model">g2p.disbursement.cycle</field>
        <field name="arch" type="xml">
            <tree default_order="creation_date desc" delete="false">
                <control>
                    <create string="Create New Disbursement Cycle"/>
                </control>
                <field name="cycle_mnemonic" string="Cycle"/>
                <field name="list_count" string="# Lists"/>
                <field name="approved_count" string="# Approved"/>
                <field name="pending_count" string="# Pending"/>
                <field name="wip_stage_name" string="WIP Stage"/>
                <field name="creation_date" string="Created On"/>
                <button name="action_open_view" type="object" string="View Disbursement Cycle" class="oe_link"/>
            </tree>
        </field>
    </record>
</odoo>
