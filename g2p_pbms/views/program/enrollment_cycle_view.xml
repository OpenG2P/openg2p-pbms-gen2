<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_enrollment_cycle_form" model="ir.ui.view">
        <field name="name">g2p.enrollment.cycle.form</field>
        <field name="model">g2p.enrollment.cycle</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_refresh_data" type="object" string="Refresh Data" class="btn-secondary" icon="fa-refresh" invisible="not id"/>
                </header>
                <sheet>
                    <group colspan="2">
                        <group string="Enrollment Cycle">
                            <field name="is_readonly" invisible="1"/>
                            <field name="has_wip_list" invisible="1"/>
                            <field name="cycle_number" readonly="1"/>
                            <field name="program_id" readonly="1"/>
                        </group>
                        <group string="Summary">
                            <field name="list_count" string="Total Lists" readonly="1"/>
                            <field name="approved_count" string="Approved" readonly="1"/>
                            <field name="pending_count" string="Pending" readonly="1"/>
                            <field name="wip_stage_name" string="WIP Stage" readonly="1" invisible="not wip_stage_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Enrollment Lists" invisible="id == False">
                            <field name="beneficiary_list_ids" nolabel="1">
                                <tree default_order="creation_date desc" delete="false" limit="10">
                                    <control>
                                        <create string="Create New Enrollment List" invisible="parent.has_wip_list"/>
                                    </control>
                                    <field name="mnemonic" string="Mnemonic"/>
                                    <field name="eligibility_process_status" string="Eligibility Status" widget="badge"/>
                                    <field name="workflow_approval_status" string="Approval Status" widget="badge"/>
                                    <field name="current_stage_name" string="Current Stage"/>
                                    <field name="creation_date" string="Created On" readonly="1"/>
                                    <field name="processed_date" string="Processed On" readonly="1"/>
                                    <button name="action_approve_stage" type="object" string="Approve" class="btn-success"
                                        invisible="workflow_approval_status != 'PENDING'"
                                        groups="g2p_pbms.group_enrolment_approver"/>
                                    <button name="action_reject_stage" type="object" string="Reject" class="btn-danger"
                                        invisible="workflow_approval_status != 'PENDING'"
                                        groups="g2p_pbms.group_enrolment_approver"/>
                                    <button name="action_open_summary_wizard" type="object" string="View List" class="oe_link"
                                        invisible="eligibility_process_status != 'complete'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Stage History" invisible="id == False">
                            <field name="beneficiary_list_ids" nolabel="1" readonly="1">
                                <tree create="0" delete="0" default_order="creation_date desc" limit="10">
                                    <field name="mnemonic" string="List"/>
                                    <field name="stage_history_ids" string="History" widget="many2many_tags" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_enrollment_cycle" model="ir.actions.act_window">
        <field name="name">Enrollment Cycle</field>
        <field name="res_model">g2p.enrollment.cycle</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
    </record>

    <record id="view_enrollment_cycle_tree" model="ir.ui.view">
        <field name="name">g2p.enrollment.cycle.tree</field>
        <field name="model">g2p.enrollment.cycle</field>
        <field name="arch" type="xml">
            <tree default_order="cycle_number desc" delete="false">
                <control>
                    <create string="Create New Enrollment Cycle"/>
                </control>
                <field name="cycle_number" string="Cycle Number"/>
                <field name="list_count" string="# Lists"/>
                <field name="approved_count" string="# Approved"/>
                <field name="pending_count" string="# Pending"/>
                <field name="wip_stage_name" string="WIP Stage"/>
                <button name="action_open_view" type="object" string="View Enrollment Cycle" class="oe_link"/>
            </tree>
        </field>
    </record>
</odoo>
