<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Action for Programs -->
  <record id="action_g2p_programs" model="ir.actions.act_window">
    <field name="name">Programs</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Program Form View -->
  <record id="view_g2p_programs_form" model="ir.ui.view">
    <field name="name">g2p.programs.form</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <form string="G2P Programs">
        <sheet>
          <group>
            <group string="Program Information">
              <field name="id" invisible="1"/>
              <field name="program_mnemonic" readonly="not context.get('program_form_edit')"/>
              <field name="description" readonly="not context.get('program_form_edit')"/>
              <field name="program_status" readonly="not context.get('program_form_edit')"/>
            </group>
            <group string="Program Configuration">
              <field string="Base Registry" name="target_registry" readonly="not context.get('program_form_create')"/>
              <field name="service_providers_required" readonly="not context.get('program_form_create')"/>
              <field name="show_label_for_beneficiary_list" invisible="1"/>
            </group>
            <group string="Enrollment Configuration" >
              <field string="Frequency" name="enrollment_frequency" readonly="not context.get('program_form_edit')"/>
              <field string="# of Verifications" name="verifications_for_enrolment" readonly="not context.get('program_form_edit')"/>
              <field name="auto_approve_enrolment" readonly="not context.get('program_form_edit')"/>
            </group>
            <group string="Disbursement Configuration" >
              <field string="Frequency" name="disbursement_frequency" readonly="not context.get('program_form_edit')"/>
              <field string="# of Verifications" name="verifications_for_disbursement" readonly="not context.get('program_form_edit')"/>
              <field name="auto_approve_disbursement" readonly="not context.get('program_form_edit')"/>
            </group>
          </group>
          <notebook>
            <!-- Benefit Codes Page (Invisible) -->
            <page string="Benefit Codes" invisible="1">
              <field name="benefit_code_ids" nolabel="1" />
            </page>
            <!-- Program Benefit Codes Page -->
            <page string="Program Benefit Codes">
              <field name="program_benefit_code_ids" nolabel="1" options="{'no_quick_create': True}"/>
            </page>
            <!-- Eligibility Rules Page -->
            <page string="Eligibility Rules">
              <field name="eligibility_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_program_id': id, 'default_target_registry': target_registry}"/>
            </page>
            <!-- Entitlement Rules Page -->
            <page string="Entitlement Rules">
              <field name="entitlement_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_target_registry': target_registry, 'default_allowed_benefit_code_ids': benefit_code_ids}"/>
            </page>
            <!-- Enrollment Cycles Page -->
            <page string="Enrollment Cycles">
              <field name="enrollment_cycle_ids" no_label="0" context="{'default_program_id': id}" mode="tree" />
            </page>
            <!-- Disbursement Cycles Page -->
            <page string="Disbursement Cycles">
              <field name="disbursement_cycle_ids" nolabel="1"/>                
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Program Tree View (defined first so act_window.view refs resolve correctly) -->
  <record id="view_g2p_programs_tree" model="ir.ui.view">
    <field name="name">g2p.programs.tree</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <tree string="G2P Programs">
        <control>
          <create string="Add Program"/>
        </control>
        <field name="program_mnemonic" />
        <field name="description"/>
        <field name="target_registry"/>
        <field name="program_status"/>
        <button name="action_open_edit" type="object" class="fa fa-pencil" title="Edit" groups="g2p_pbms.group_program_editor"/>
      </tree>
    </field>
  </record>

  <!-- Program Configuration Form View -->
  <record id="view_g2p_programs_config_form" model="ir.ui.view">
    <field name="name">g2p.programs.config.form</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <form string="Program Configuration">
        <sheet>
          <group>
            <group string="Program Information">
              <field name="id" invisible="1"/>
              <field name="program_mnemonic" readonly="not context.get('program_form_edit')"/>
              <field name="description" readonly="not context.get('program_form_edit')"/>
              <field name="program_status" readonly="not context.get('program_form_edit')"/>
            </group>
            <group string="Program Configuration">
              <field string="Base Registry" name="target_registry" readonly="not context.get('program_form_create')"/>
              <field name="service_providers_required" readonly="not context.get('program_form_create')"/>
              <field name="show_label_for_beneficiary_list" invisible="1"/>
            </group>
            <group string="Enrollment Configuration">
              <field string="Frequency" name="enrollment_frequency" readonly="not context.get('program_form_edit')"/>
            </group>
            <group string="Disbursement Configuration">
              <field string="Frequency" name="disbursement_frequency" readonly="not context.get('program_form_edit')"/>
            </group>
          </group>
          <notebook>
            <!-- Benefit Codes Page (Invisible) -->
            <page string="Benefit Codes" invisible="1">
              <field name="benefit_code_ids" nolabel="1"/>
            </page>
            <!-- Program Benefit Codes Page -->
            <page string="Program Benefit Codes">
              <field name="program_benefit_code_ids" nolabel="1" options="{'no_quick_create': True}"/>
            </page>
            <!-- Eligibility Rules Page -->
            <page string="Eligibility Rules">
              <field name="eligibility_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_program_id': id, 'default_target_registry': target_registry}"/>
            </page>
            <!-- Entitlement Rules Page -->
            <page string="Entitlement Rules">
              <field name="entitlement_rule_ids" nolabel="1" options="{'no_quick_create': True}" context="{'default_target_registry': target_registry, 'default_allowed_benefit_code_ids': benefit_code_ids}"/>
            </page>
            <!-- Approval Workflow Page -->
            <page string="Approval Workflow">
              <field name="workflow_stage_ids" nolabel="1" context="{'default_program_id': id}" options="{'no_quick_create': True}">
                <tree string="Workflow Stages" default_order="cycle_type, stage_number">
                  <control>
                    <create string="Add New Stage"/>
                  </control>
                  <field name="cycle_type"/>
                  <field name="stage_number"/>
                  <field name="stage_name"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Program Operations Form View (formerly Program Management) -->
  <record id="view_g2p_programs_management_form" model="ir.ui.view">
    <field name="name">g2p.programs.management.form</field>
    <field name="model">g2p.program.definition</field>
    <field name="arch" type="xml">
      <form string="Program Operations">
        <sheet>
          <field name="id" invisible="1"/>
          <notebook>
            <!-- Enrollment Cycles Page -->
            <page string="Enrollment Cycles">
              <field name="enrollment_cycle_ids" no_label="0" context="{'default_program_id': id}" mode="tree"/>
            </page>
            <!-- Disbursement Cycles Page -->
            <page string="Disbursement Cycles">
              <field name="disbursement_cycle_ids" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action for Program Configuration -->
  <record id="action_g2p_programs_config" model="ir.actions.act_window">
    <field name="name">Program Configuration</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'program_view_mode': 'config'}</field>
  </record>
  <record id="action_g2p_programs_config_tree" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_config"/>
    <field name="view_id" ref="view_g2p_programs_tree"/>
    <field name="view_mode">tree</field>
    <field name="sequence">1</field>
  </record>
  <record id="action_g2p_programs_config_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_config"/>
    <field name="view_id" ref="view_g2p_programs_config_form"/>
    <field name="view_mode">form</field>
    <field name="sequence">2</field>
  </record>

  <!-- Action for Program Operations -->
  <record id="action_g2p_programs_management" model="ir.actions.act_window">
    <field name="name">Program Operations</field>
    <field name="res_model">g2p.program.definition</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'program_view_mode': 'management'}</field>
  </record>
  <record id="action_g2p_programs_management_tree" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_management"/>
    <field name="view_id" ref="view_g2p_programs_tree"/>
    <field name="view_mode">tree</field>
    <field name="sequence">1</field>
  </record>
  <record id="action_g2p_programs_management_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_g2p_programs_management"/>
    <field name="view_id" ref="view_g2p_programs_management_form"/>
    <field name="view_mode">form</field>
    <field name="sequence">2</field>
  </record>

</odoo>
